config_version=5

[application]
config/name="VIDA"
run/main_scene="res://scenes/app.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
LifeEvents="*res://scripts/systems/life_events.gd"
GameClock="*res://scripts/systems/game_clock.gd"
WeatherSystem="*res://scripts/systems/weather_system.gd"
LifeSimulation="*res://scripts/systems/life_simulation.gd"
MissionSystem="*res://scripts/systems/mission_system.gd"
InputManager="*res://scripts/systems/input_manager.gd"
SaveSystem="*res://scripts/systems/save_system.gd"
WorldManager="*res://scripts/systems/world_manager.gd"
AudioSystem="*res://scripts/systems/audio_system.gd"
MCPBridge="*res://addons/godot_mcp/mcp_bridge.gd"

[display]
window/size/viewport_width=800
window/size/viewport_height=450
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[input_devices]
pointing/emulate_mouse_from_touch=true

[rendering]
textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
